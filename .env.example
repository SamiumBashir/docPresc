# ==============================================================================
# DocPresc Full-Stack Monorepo Environment Configuration Template
# ==============================================================================
# Copy this file to:
#   - `backend/.env` (for backend service configuration)
#   - `frontend/.env` (for frontend browser client configuration)
# DO NOT COMMIT REAL PRODUCTION SECRETS TO VERSION CONTROL!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Server Configuration (backend/.env)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# MongoDB Database Connection URL
# Example Local: mongodb://localhost:27017/prescription_db
# Example Atlas: mongodb+srv://<user>:<password>@cluster0.mongodb.net/prescription_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/prescription_db

# Security & JSON Web Token (JWT)
JWT_SECRET=docpresc_jwt_super_secret_signing_key_replace_in_production_2026
JWT_EXPIRES_IN=7d
COOKIE_SECRET=docpresc_cookie_secret_key_replace_in_production_2026

# Cross-Origin Resource Sharing (CORS) & Host Redirection
# Comma-separated list of allowed frontend origins:
CORS_ORIGIN=http://localhost:5173,https://doc-presc.vercel.app
FRONTEND_URL=http://localhost:5173

# Email Delivery Configuration (Provider: 'smtp' | 'resend' | 'brevo' | 'auto')
EMAIL_PROVIDER=smtp
ENABLE_EMAIL_FALLBACK=false

# Nodemailer / Gmail SMTP Configuration (Recommended free solution without purchasing domain)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
EMAIL_FROM=Doc Presc <your_email@gmail.com>

# Optional Third-Party Transactional Email APIs
RESEND_API_KEY=
BREVO_API_KEY=

# Password Reset Security & OTP Configuration
OTP_EXPIRES_IN=600
OTP_RESEND_COOLDOWN=60
OTP_PEPPER=docpresc_otp_security_pepper_replace_in_production_2026

# Optional: Redis Cache & Temporary State Store
REDIS_URL=

# Optional: Cloudinary Configuration for Doctor Chamber Logos & Signatures
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# 2. Frontend Application Configuration (frontend/.env)
# ------------------------------------------------------------------------------
# In local development, the Vite dev server proxy directs /api to http://127.0.0.1:5000
# In production on Vercel/Netlify, point to your deployed backend API URL (e.g., Render/Railway)
VITE_API_BASE_URL=http://localhost:5000/api
