{
  "name": "prescription-system",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "start": "node dist/server.js",
    "build": "npm --prefix backend run build && npm --prefix frontend run build && node scripts/setup-root-dist.js",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "dev": "concurrently \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "typecheck": "npm --prefix frontend run typecheck && npm --prefix backend run typecheck",
    "typecheck:frontend": "npm --prefix frontend run typecheck",
    "typecheck:backend": "npm --prefix backend run typecheck",
    "lint": "npm --prefix frontend run lint && npm --prefix backend run lint",
    "lint:frontend": "npm --prefix frontend run lint",
    "lint:backend": "npm --prefix backend run lint",
    "test": "npm --prefix backend test",
    "test:backend": "npm --prefix backend test",
    "test:frontend": "npm --prefix frontend test",
    "test:e2e": "npm --prefix backend run test:e2e",
    "test:all": "npm --prefix backend run test:all",
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "seed": "npm --prefix backend run seed",
    "scrape:medex": "npm --prefix backend run scrape:medex",
    "clean:medex": "npm --prefix backend run clean:medex",
    "import:medex": "npm --prefix backend run import:medex"
  },
  "dependencies": {
    "nodemailer": "^10.1.0",
    "typescript": "^5.5.4",
    "vite": "^8.3.4"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
